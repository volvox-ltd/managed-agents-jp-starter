# どちらか一方を設定（両方設定すると SDK は両方送り、API が拒否する）
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=   # `ant auth login` のプロファイルを使う場合は空のままで良い

# Console のセッション画面 URL に使う。Default ワークスペース以外ならそのIDを入れる
ANTHROPIC_WORKSPACE=default

# 章 9 以降で使う
MA_MODEL=claude-opus-5
# SLACK_BOT_TOKEN=xoxb-...      # 章 7: Vault の environment_variable に登録する値
# SLACK_CHANNEL=C0123456789
# ANTHROPIC_WEBHOOK_SIGNING_KEY=whsec_...   # 章 12: Console で発行される署名鍵
